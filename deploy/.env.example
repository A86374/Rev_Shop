# Copy to /opt/revshop/.env on the EC2 server, fill in real values, then: chmod 600 .env
# Never commit the real .env.
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=latest
RDS_ENDPOINT=revshop-db.xxxxxxxxxxxx.ap-southeast-2.rds.amazonaws.com
DB_PASSWORD=the-revshop_app-password
JWT_SECRET=a-long-random-string-of-at-least-32-characters
AWS_REGION=ap-southeast-2
